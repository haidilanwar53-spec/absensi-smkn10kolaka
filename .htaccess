# ==============================================================================
# SMK NEGERI 10 KOLAKA - WEB SECURITY CONFIGURATION (.htaccess)
# ==============================================================================

# 1. Disable Directory Indexing / Browsing
Options -Indexes

# 2. Block access to hidden files and directories (e.g. .git, .env, .agents, .claude, .limits)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} "(^|/)\."
    RewriteRule ^ - [F,L]
</IfModule>

# 3. Block access to sensitive files (configuration, source scripts, logs, repo metadata)
<FilesMatch "(?i)\.(json|lock|py|bat|cmd|sh|md|bak|config|env|yml|yaml|log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Allow manifest.json explicitly for Progressive Web App (PWA) support
<Files "manifest.json">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
    </IfModule>
</Files>

# 4. HTTP Security Response Headers
<IfModule mod_headers.c>
    # Prevent Clickjacking by restricting framing to same origin
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # Prevent MIME Sniffing
    Header always set X-Content-Type-Options "nosniff"
    
    # Enable Cross-Site Scripting (XSS) filter built into legacy browsers
    Header always set X-XSS-Protection "1; mode=block"
    
    # Referrer Policy for privacy protection
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Permissions Policy (allow geolocation and camera for attendance QR scan, restrict mic)
    Header always set Permissions-Policy "geolocation=(self), camera=(self), microphone=()"
</IfModule>

# 5. Correct MIME Types
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest .json
    AddType audio/mpeg .mp3
    AddType image/webp .webp
    AddType text/javascript .js
    AddType text/css .css
</IfModule>
